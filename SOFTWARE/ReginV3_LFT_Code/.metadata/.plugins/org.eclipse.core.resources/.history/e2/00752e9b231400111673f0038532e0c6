void delay_us(uint16_t us) //Blocking function
{
	__HAL_TIM_SET_COUNTER(&htim1,0);  // set the counter value a 0
	while (__HAL_TIM_GET_COUNTER(&htim1) < us);  // wait for the counter to reach the us input in the parameter
}
void delay_us(uint16_t us)
{
    uint16_t start = __HAL_TIM_GET_COUNTER(&htim1);

    while((uint16_t)(__HAL_TIM_GET_COUNTER(&htim1) - start) < us);
}
static int SensorRead(LineFollower_t *LF)
{
	int pos = 0;
	int active = 0;

	GPIO_PinState S[4];

	for(uint8_t val = 0; val < 16; val++)
	{
	    // rozbicie 4-bitowej liczby na pojedyncze bity
	    S[0] = (val & (1 << 0)) ? GPIO_PIN_SET : GPIO_PIN_RESET;
	    S[1] = (val & (1 << 1)) ? GPIO_PIN_SET : GPIO_PIN_RESET;
	    S[2] = (val & (1 << 2)) ? GPIO_PIN_SET : GPIO_PIN_RESET;
	    S[3] = (val & (1 << 3)) ? GPIO_PIN_SET : GPIO_PIN_RESET;

	    HAL_GPIO_WritePin(S0_GPIO_Port, S0_Pin, S[0]);
	    HAL_GPIO_WritePin(S0_GPIO_Port, S1_Pin, S[1]);
	    HAL_GPIO_WritePin(S0_GPIO_Port, S2_Pin, S[2]);
	    HAL_GPIO_WritePin(S0_GPIO_Port, S3_Pin, S[3]);

	    delay_10us();

	    GRUZIK.SensorArray[val] = GRUZIK.Adc1_Values[0];
	}

	if (LF->SensorArray[0] > LF->treshold)
	{
		pos += 16000;
		active++;
		if(HAL_GetTick() > (LF->LastEndTimer + 1))
		{
 			LF->LastEndTimer = HAL_GetTick();
			LF->Last_end = 0;//1
		}
	}
	if (LF->SensorArray[1] > LF->treshold)
	{
		pos += 15000;
		active++;
	}
	if (LF->SensorArray[2] > LF->treshold)
	{
		pos += 14000;
		active++;
	}
	if (LF->SensorArray[3] > LF->treshold)
	{
		pos += 13000;
		active++;
	}
	if (LF->SensorArray[4] > LF->treshold)
	{
		pos += 12000;
		active++;
	}
	if (LF->SensorArray[5] > LF->treshold)
	{
		pos += 11000;
		active++;
	}
	if (LF->SensorArray[6] > LF->treshold)
	{
		pos += 10000;
		active++;
	}
	if (LF->SensorArray[7] > LF->treshold)
	{
		pos += 9000;
		active++;
	}
	if (LF->SensorArray[8] > LF->treshold)
	{
		pos += 8000;
		active++;
	}
	if (LF->SensorArray[9] > LF->treshold)
	{
		pos += 7000;
		active++;
	}
	if (LF->SensorArray[10] > LF->treshold)
	{
		pos += 6000;
		active++;
	}
	if (LF->SensorArray[11] > LF->treshold)
	{
		pos += 5000;
		active++;
	}
	if (LF->SensorArray[12] > LF->treshold)
	{
		pos += 4000;
		active++;
	}
	if (LF->SensorArray[13] > LF->treshold)
	{
		pos += 3000;
		active++;
	}
	if (LF->SensorArray[14] > LF->treshold)
	{
		pos += 2000;
		active++;
	}
	if (LF->SensorArray[15] > LF->treshold)
	{
		pos += 1000;
		active++;
		if(HAL_GetTick() > (LF->LastEndTimer + 1))
		{
			LF->LastEndTimer = HAL_GetTick();
			LF->Last_end = 1;//0
		}
	}

	LF->actives = active;

	if (LF->actives == 0)
	{
		LF->Last_idle++;
	}
	else
	{
		LF->Last_idle = 0;
	}
	if(active != 0)
	{
		LF->SensorPosition = pos/active;
	}
	else
	{
		if(LF->Last_end == 1)
		{
			LF->SensorPosition = 12000;
		}
		else
		{
			LF->SensorPosition = 1000;
		}
//		return 0;
	}

	return LF->SensorPosition;
}
