//Bluetooth communication
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
	if(huart->Instance == USART1)
	{
		if(RB_Write(&ReceiveBuffer, RxData) == RB_OK)
		{
			if(RxData == ENDLINE)
			{
				ReceivedLines++;
			}
		}
    	HAL_UART_Receive_IT(&huart1,&RxData, 1);
	}
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
	//Motor control and PID 2KHz
	if(htim->Instance == TIM20)
	{
		/*Startup,communication & motor management*/

		if(GRUZIK.PowerMode == Start)
		{
			Breaking = 0;
			/*Following the line after the vacuuming part is done*/
			if((Vaccuming != 1))
			{
				PID_control(&GRUZIK);

				Vaccuming = 1;
				Vaccuming_Timer = HAL_GetTick();

				ESC_SetThrottle(GRUZIK.Turbine_Speed);
			}
			if((Vaccuming == 1)&&(HAL_GetTick() > Vaccuming_Timer + 1000))
			{
				HAL_GPIO_WritePin(INH_GPIO_Port, INH_Pin, GPIO_PIN_SET);

			}
		}
		else
		{
			/*Stop all motors*/
			motor_control(&GRUZIK, 200, 200);

			if(Breaking != 1)
			{
				Breaking_Timer = HAL_GetTick();
				Breaking = 1;
			}

			if((Breaking == 1)&&(HAL_GetTick() > 1000 + Breaking_Timer))
			{
				HAL_GPIO_WritePin(INH_GPIO_Port, INH_Pin, GPIO_PIN_RESET);
				ESC_SetThrottle(1000);
				Vaccuming = 0;
			}

		}
	}
}
