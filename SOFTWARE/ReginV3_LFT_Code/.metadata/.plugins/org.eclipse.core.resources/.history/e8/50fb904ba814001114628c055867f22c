/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_TIM2_Init();
  MX_TIM5_Init();
  MX_TIM20_Init();
  if (MX_FATFS_Init() != APP_OK) {
    Error_Handler();
  }
  MX_TIM3_Init();
  MX_TIM16_Init();
  MX_USART1_UART_Init();
  MX_TIM1_Init();
  /* USER CODE BEGIN 2 */
  /*GRUZIK STATE SETING*/
   GRUZIK.PowerMode = Initialization;
   GRUZIK.state = PidFollowing;

 	/*Initial setting for robot*/
   	if(GRUZIK.state == PidFollowing)
   	{
   	   /*PID*/
   	   GRUZIK.Kp = 0.015;
   	   GRUZIK.Kd = 0.55;
 		/*Motors settings*/
 		GRUZIK.Base_speed_R = 125;
 		GRUZIK.Base_speed_L = 125;
 		GRUZIK.Max_speed_L = 200;
 		GRUZIK.Max_speed_R = 200;
 		GRUZIK.Sharp_bend_speed_right = -75;
 		GRUZIK.Sharp_bend_speed_left = 120;
 		GRUZIK.Bend_speed_right = -75;
 		GRUZIK.Bend_speed_left = 120;
   	}

   	GRUZIK.Speed_offset = 0.014;

   	HAL_GPIO_WritePin(E_GPIO_Port, E_Pin, GPIO_PIN_RESET);

   	//50Hz, 1Hz and 2KHz timers
	HAL_TIM_Base_Start_IT(&htim20);
	HAL_TIM_Base_Start(&htim1);

	HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_1); //PWM2_R
	HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_2); //PWM2_L

	HAL_TIM_PWM_Start(&htim5, TIM_CHANNEL_2); //PWM1_L
	HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1); //PWM1_R
	HAL_TIM_PWM_Start(&htim16, TIM_CHANNEL_1); //PWM_T
	ESC_Arm();
	GRUZIK.Turbine_Speed = 1100;

    /*Start receiving data from Blue tooth*/
    HAL_ADC_Start_DMA(&hadc1, (uint32_t*)&GRUZIK.Adc1_Values, 2);
    HAL_UART_Receive_IT(&huart1, &RxData, 1);

    uint32_t lasttime1 = HAL_GetTick();



    /*Sensor Preparation and entering STOP mode*/
    GRUZIK.LastEndTimer = HAL_GetTick();
    GRUZIK.treshold = 3700;//1500
    GRUZIK.LineFollowing = 0;
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  SensorRead();

	  /*Blink LED1*/
	if(HAL_GetTick() > (lasttime1 + 500))
	{
	  lasttime1 = HAL_GetTick();
	  HAL_GPIO_TogglePin(LED2_GPIO_Port, LED2_Pin);
	  HAL_GPIO_TogglePin(LED1_GPIO_Port, LED1_Pin);
	}
	/*Bluetooth check*/
	if(ReceivedLines > 0)
	{
	  Parser_TakeLine(&ReceiveBuffer, ReceivedData);
	  Parser_Parse(ReceivedData,&GRUZIK);

	  ReceivedLines--;
	}
  }
  /* USER CODE END 3 */
}

