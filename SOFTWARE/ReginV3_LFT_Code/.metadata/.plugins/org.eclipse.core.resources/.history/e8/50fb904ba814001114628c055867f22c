void delay_us (uint16_t us) //Blocking function
{
	__HAL_TIM_SET_COUNTER(&htim1,0);  // set the counter value a 0
	while (__HAL_TIM_GET_COUNTER(&htim1) < us);  // wait for the counter to reach the us input in the parameter
}

void SensorRead1()
{
	HAL_GPIO_WritePin(S0_GPIO_Port, S0_Pin, GPIO_PIN_SET);
	HAL_GPIO_WritePin(S1_GPIO_Port, S1_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(S2_GPIO_Port, S2_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(S3_GPIO_Port, S3_Pin, GPIO_PIN_RESET);

	delay_us(100);

	GRUZIK.SensorArray[0] = GRUZIK.Adc1_Values[0];
}

void SensorRead()
{
    for(uint8_t val = 0; val < 16; val++)
    {
        HAL_GPIO_WritePin(S0_GPIO_Port, S0_Pin, (val & 0x08) ? GPIO_PIN_SET : GPIO_PIN_RESET);
        HAL_GPIO_WritePin(S1_GPIO_Port, S1_Pin, (val & 0x04) ? GPIO_PIN_SET : GPIO_PIN_RESET);
        HAL_GPIO_WritePin(S2_GPIO_Port, S2_Pin, (val & 0x02) ? GPIO_PIN_SET : GPIO_PIN_RESET);
        HAL_GPIO_WritePin(S3_GPIO_Port, S3_Pin, (val & 0x01) ? GPIO_PIN_SET : GPIO_PIN_RESET);

        delay_us(100);

        GRUZIK.SensorArray[val] = GRUZIK.Adc1_Values[0];
    }
}

void ESC_SetThrottle(uint16_t us)
{
    if(us < ESC_MIN) us = ESC_MIN;
    if(us > ESC_MAX) us = ESC_MAX;

    __HAL_TIM_SET_COMPARE(&htim16, TIM_CHANNEL_1, us);
}

void ESC_Arm(void)
{

    ESC_SetThrottle(ESC_MIN);                  // ustaw minimum gazu

    HAL_Delay(2000);                           // 2 sekundy stabilnego sygnału
}
